NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://app.example.com,https://admin.example.com
DATABASE_URL=postgresql://user:pass@db-host:5432/eof_talent
REDIS_URL=redis://redis-host:6379
JWT_ACCESS_SECRET=replace-access-secret
JWT_REFRESH_SECRET=replace-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=replace-access-key
S3_SECRET_KEY=replace-secret-key
S3_BUCKET=eof-talent-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false
OTP_TEST_BYPASS=false
