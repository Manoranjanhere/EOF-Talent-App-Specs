PORT=3000

# Local PC:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eof_talent"

# EC2 Docker Compose (host must be "postgres", not localhost):
# See deploy/ec2.env.example and deploy/README-EC2.md
# DATABASE_URL="postgresql://eof:YOUR_PASSWORD@postgres:5432/eof_talent"

JWT_ACCESS_SECRET="replace-me-access-secret"
JWT_REFRESH_SECRET="replace-me-refresh-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# --- Media storage ---
# Default (recommended for EC2 start): files under backend/uploads
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# AWS S3 (optional later):
# STORAGE_DRIVER=s3
# S3_REGION=ap-south-1
# S3_BUCKET=eof-talent-images
# S3_ACCESS_KEY=AKIA...
# S3_SECRET_KEY=...
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_FORCE_PATH_STYLE=false

CORS_ORIGINS=*
OTP_TEST_BYPASS=true
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
