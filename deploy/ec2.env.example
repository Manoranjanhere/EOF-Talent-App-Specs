# ============================================================
# EC2 production env — copy to repo root as `.env` on the server:
#   cp deploy/ec2.env.example .env
#   nano .env   # change passwords & JWT secrets
#
# Instance:  i-088f3d250343e2527
# Public IP: 13.203.201.155
# Private:   172.31.3.87
# API URL:   http://13.203.201.155:3000/api
# Swagger:   http://13.203.201.155:3000/docs
# ============================================================

PORT=3000

# Postgres (Docker Compose service name is "postgres")
POSTGRES_USER=eof
POSTGRES_PASSWORD=12345678
POSTGRES_DB=eof_talent
# DATABASE_URL is set automatically by docker-compose from the vars above.
# Do not point DATABASE_URL at localhost — inside Docker use host "postgres".

JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Local disk storage on the EC2 volume (good enough to start)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MEDIA_SIGNING_SECRET=replace-with-long-random-media-signing-secret

# CORS — allow mobile clients
CORS_ORIGINS=*

# OTP / Firebase
# For real phone OTP on the APK, you MUST mount firebase-service-account.json
OTP_TEST_BYPASS=false
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Google Play Billing (subscriptions + job slot one-time products)
GOOGLE_PLAY_PACKAGE_NAME=com.anonymous.eoftalentapp
# Path to Play Console linked service account JSON (or raw JSON string)
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=./google-play-service-account.json
# Staging only — accept tokens starting with dev-bypass: (never in production)
PLAY_BILLING_BYPASS=false
PLAY_SKU_MSG_MEMBER_100=eof_msg_member_100
PLAY_SKU_MSG_EMPLOYER_300=eof_msg_employer_300
PLAY_SKU_JOB_POST_300_90=eof_job_post_300

# Set true only once for first boot if you want seed data
SEED_ON_START=false
