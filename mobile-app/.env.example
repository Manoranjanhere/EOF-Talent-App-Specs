# --- Production EC2 (rebuild APK after changing this) ---
# Instance i-088f3d250343e2527 — Public IP 13.203.201.155
EXPO_PUBLIC_API_URL=http://13.203.201.155:3000/api

# Android Studio emulator (maps to your PC localhost):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Physical phone on same Wi-Fi as your PC (LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000/api

# Web browser on same machine:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Google Play — package must match app.json android.package
EXPO_PUBLIC_PLAY_PACKAGE_NAME=com.anonymous.eoftalentapp
# Testing: skip Play Store sheet (server PLAY_BILLING_BYPASS must also be true).
# Production APK: set false and use real Google Play Billing.
EXPO_PUBLIC_PLAY_BILLING_BYPASS=true
EXPO_PUBLIC_PLAY_SKU_MSG_MEMBER_100=eof_msg_member_100
EXPO_PUBLIC_PLAY_SKU_MSG_EMPLOYER_300=eof_msg_employer_300
EXPO_PUBLIC_PLAY_SKU_TALENT_SERIOUS_JOB_200=eof_talent_serious_200
EXPO_PUBLIC_PLAY_SKU_JOB_POST_100_90=eof_job_post_100
