<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Allow HTTP to EC2 / LAN during development. Prefer HTTPS in production. -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
