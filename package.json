{
  "name": "eof-talent-app",
  "private": true,
  "version": "1.0.0",
  "description": "EOF Talent marketplace monorepo",
  "workspaces": [
    "backend",
    "mobile-app",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "start": "npm run start --workspace mobile-app",
    "start:backend": "npm run start:dev --workspace backend",
    "start:mobile": "npm run start --workspace mobile-app",
    "android": "npm run android --workspace mobile-app",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace backend",
    "prisma:seed": "npm run prisma:seed --workspace backend",
    "ios": "expo run:ios",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "overrides": {
    "react-native-screens": "3.31.1"
  }
}
